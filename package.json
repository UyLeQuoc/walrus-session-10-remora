{
  "name": "remora",
  "private": true,
  "version": "0.0.1",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "docker compose up -d --wait && turbo run dev --filter=@remora/server --filter=@remora/web --ui=tui",
    "dev:server": "bun run --filter @remora/server dev",
    "dev:web": "bun run --filter @remora/web dev",
    "hippo": "bun run --filter @remora/core hippo",
    "smoke": "bun run --filter @remora/memory smoke",
    "db:push": "bun run --filter @remora/db push",
    "db:studio": "bun run --filter @remora/db studio",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "demo": "bun run --filter @remora/core demo",
    "evidence": "bun run --filter @remora/server evidence",
    "evals": "bun run --filter @remora/server evals",
    "restore": "bun run --filter @remora/server restore",
    "diagnose": "bun run --filter @remora/server diagnose && bun run --filter @remora/memory diagnose",
    "diagnose:memory": "bun run --filter @remora/memory diagnose",
    "prune:people": "bun run --filter @remora/server prune:people",
    "capacity": "bun run --filter @remora/server capacity",
    "ops": "bun run --filter @remora/server ops",
    "evidence:daily": "bash scripts/evidence-daily.sh",
    "measure:corrections": "bun run --filter @remora/core measure:corrections",
    "e2e": "bun run --filter @remora/e2e e2e",
    "e2e:main": "bun run --filter @remora/e2e e2e:main",
    "docs:links": "bun scripts/check-links.ts",
    "docs:tatum": "bun scripts/tatum-calls.ts",
    "secrets:history": "bun scripts/scan-history.ts"
  },
  "devDependencies": {
    "@bun-security-scanner/osv": "^1.0.0",
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "source-map-js": ">=1.2.2",
    "follow-redirects": ">=1.16.2",
    "vite": ">=8.3.5",
    "hono": ">=4.13.13",
    "vitest": "^4.1.12",
    "@vitest/mocker": "^4.1.12",
    "@vanilla-extract/css": "1.21.3"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@tailwindcss/oxide",
    "@mysten/walrus-wasm",
    "esbuild"
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "spikes/*",
    "e2e"
  ]
}
