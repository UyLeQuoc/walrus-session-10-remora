# ── Walrus Memory (operator account, mainnet) ─────────────────────────────
# Create at https://memory.walrus.xyz with the dedicated Sessions wallet.
# MEMWAL_ACCOUNT_ID is the MemWalAccount OBJECT id, not your wallet address and
# not the delegate public key. Run: bun run packages/memory/scripts/find-account.ts
# The value below is hippo's own account; with your own key, replace it with yours.
MEMWAL_ACCOUNT_ID=             # your Walrus Memory account object ID (memory.walrus.xyz)
MEMWAL_PRIVATE_KEY=            # delegate private key, 64 hex. Server only.
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_PACKAGE_ID=0xe7c16fbea0560e7057e2bf7422feaa4fb313749fc69c9e9092fac7a33b81d7f5   # from GET /config, NOT the docs value: a second mainnet deployment supersedes it
MEMWAL_REGISTRY_ID=0x8bf82c9e09e36b8d1c38298f68b7cb68e7b8762887e7592add9986d5e9cf199f
SUI_NETWORK=mainnet

# ── LLM via OpenRouter (primary model must not be OpenAI/Anthropic) ───────
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
LLM_FALLBACK_MODEL=qwen/qwen3.7-flash   # measured to work; qwen3-235b returns no output at all

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://remora:remora@localhost:5434/remora

# ── Server ────────────────────────────────────────────────────────────────
PORT=8787
WEB_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
SESSION_SECRET=                # openssl rand -hex 32
KEY_ENCRYPTION_KEY=            # openssl rand -hex 32 (AES-256-GCM for users' delegate keys)

# Optional feedback survey shown on /start and on the /me page. A WalForm works
# well here: https://walform.wal.app
SURVEY_URL=

# ── Channels (each adapter starts only when its token is set) ─────────────
# on | off. Use off for extra local servers and agent worktrees (one poller per bot token).
CHANNELS=on
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=           # for the A5 deep link t.me/<name>?start=link_<code>
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# ── Web ───────────────────────────────────────────────────────────────────
# Nothing to set for local dev: `bun run dev` proxies /api to the server on
# :8787, the way Vercel's rewrite does in production; HIPPO_API_URL in the shell
# points it, and `bun run hippo`, elsewhere. Vite does not read this file.
# VITE_API_URL is only for a build served where nothing can proxy, such as
# Walrus Sites, and goes in apps/web/.env or the build environment.

# Seal key server API key from Enoki (Seal Key Server API), sent as X-API-Key to the
# mainnet aggregator. Only the private-file spike and file feature need it.
SEAL_API_KEY=

# --- Remora (docs/tech-reference.md §4) ---
TATUM_API_KEY=
TATUM_SUI_GRPC=https://sui-mainnet-grpc.gateway.tatum.io
TATUM_SUI_GRPC_TESTNET=https://sui-testnet-grpc.gateway.tatum.io
TATUM_API_KEY_TESTNET=
REMORA_PACKAGE_ID=             # published remora Move package (disc + hatchery); set after E1
SPONSOR_PRIVATE_KEY=           # runtime gas sponsor, mainnet (never commit; never a funder, ADR-0020)
SPONSOR_PRIVATE_KEY_TESTNET=   # runtime gas sponsor, testnet (ADR-0026)
E2E_BURNER_KEY=                # E2E test wallet, testnet only (team-split §8); never a real owner
USDC_COIN_TYPE=0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC   # verify in U1
AI_GATEWAY_API_KEY=
FACILITATOR_URL=                # x402 facilitator + gas station, mainnet (E3, D8)
FACILITATOR_URL_TESTNET=        # x402 facilitator + gas station, testnet
WORKER=on                       # D2 job worker (off for local runs that should not spend Tatum calls)
INDEXER=off                     # D1 checkpoint indexer: streams from Tatum while on; on for exactly one deployed instance (ADR-0058)
# Facilitator + gas station (apps/facilitator, ADR-0028)
FACILITATOR_PORT=8798
SPONSOR_DAILY_GAS_MIST=200000000     # per remora key per UTC day
SPONSOR_MAX_GAS_BUDGET=50000000      # per transaction
SPONSOR_LOW_BALANCE_MIST=200000000   # warn below this
# Demo merchants (apps/merchants)
MERCHANTS_PORT=8799
MERCHANT_PAYTO=                      # demo merchants payTo, mainnet
MERCHANT_PAYTO_TESTNET=              # demo merchants payTo, testnet
SUI_RISK_PRICE=10000                 # USDC smallest units (0.01)
ODDS_PRICE=20000                     # odds (0.02)
BRIEF_PRICE=10000                    # brief (0.01)
MERCHANT_REQUIRE_DISC=0              # 1 = accept Disc payments only (ADR-0031)
MERCHANTS_URL=                       # where the server finds the demo merchants (Reef), mainnet
MERCHANTS_URL_TESTNET=               # same, testnet (e.g. http://localhost:8799)
# Remora runtime (W2)
LLM_SMALL_MODEL=                     # Sonar checks + rule parsing; defaults to LLM_MODEL (ADR-0045)
REMORA_DAILY_TOKENS=200000           # model tokens per remora per UTC day (D9)
WATCHER=off                          # D1 chain trigger for Sentinels: streams from Tatum while on; on for exactly one deployed instance, or locally when testing Sentinel (ADR-0058)
# Hatchery templates on Walrus (M3, ADR-0048); testnet defaults to the public endpoints
WALRUS_PUBLISHER_TESTNET=            # default https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_TESTNET=           # default https://aggregator.walrus-testnet.walrus.space
WALRUS_TEMPLATE_EPOCHS_TESTNET=      # default 50
WALRUS_PUBLISHER_MAINNET=            # a publisher that pays WAL; unset = no mainnet publishing (mainnet pass)
WALRUS_AGGREGATOR_MAINNET=           # default https://aggregator.walrus-mainnet.walrus.space
# Public playground (H7, ADR-0051): testnet only; unset PLAYGROUND_FUNDER_KEY = no playground
PLAYGROUND_FUNDER_KEY=               # a testnet test key with a little USDC + SUI (locally: the burner)
PLAYGROUND_MEMWAL_ACCOUNT_ID=        # optional separate Walrus Memory account; unset = memory off
PLAYGROUND_MEMWAL_PRIVATE_KEY=
PLAYGROUND_QUESTIONS=3
PLAYGROUND_SESSIONS_PER_IP=3
PLAYGROUND_POOL=10
PLAYGROUND_TTL_MINUTES=1440

# --- U11 apps, in this repo for now (ADR-0060) ---
# Receipts (Track 1, ADR-0061). Reuses DATABASE_URL, TATUM_API_KEY_TESTNET, SPONSOR_PRIVATE_KEY_TESTNET
# (sends the anchors) and the operator's Walrus Memory account (namespaces receipts:*).
RECEIPTS_PORT=8811
RECEIPTS_BASE_URL=http://localhost:8811
RECEIPTS_WORKER=off
RECEIPTS_BOT=off
RECEIPTS_ANCHOR_MINUTES=10
RECEIPTS_INGEST_MINUTES=10
# Blank: the testnet package in apps/receipts/src/deployments.ts.
RECEIPTS_PACKAGE_ID=
# Kitty (Track 3, ADR-0062). Reuses DATABASE_URL, TATUM_API_KEY_TESTNET, SPONSOR_PRIVATE_KEY_TESTNET (pays
# every Kitty transaction; never a member) and the operator's Walrus Memory account (namespaces kitty:*).
KITTY_PORT=8821
KITTY_BASE_URL=http://localhost:8821
KITTY_WORKER=off
KITTY_BOT=off
KITTY_KEEPER_SECONDS=60
# Blank: the testnet package in apps/kitty/src/deployments.ts.
KITTY_PACKAGE_ID=
# Generated by `bun apps/kitty/scripts/setup-testnet.ts` (testnet only): the keeper, and test members' keys.
KITTY_KEEPER_KEY=
KITTY_MEMBER_KEYS=
