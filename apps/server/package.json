{
  "name": "@remora/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "evidence": "tsx scripts/evidence.ts",
    "restore": "tsx scripts/restore.ts",
    "test": "vitest run",
    "discord:commands": "tsx scripts/register-discord-commands.ts",
    "probe:signin": "tsx scripts/archive/probe-signin.ts",
    "prune:people": "tsx scripts/prune.ts",
    "probe:header": "tsx scripts/archive/probe-header-identity.ts",
    "capacity": "tsx scripts/capacity.ts",
    "ops": "tsx scripts/ops.ts",
    "verify": "tsx scripts/verify.ts",
    "evals": "vitest run src/mcp/attacks.test.ts src/runtime/attacks.test.ts src/hatchery/attacks.test.ts && tsx scripts/evals-summary.ts",
    "probe:facts": "tsx scripts/probe-facts.ts",
    "probe:facts:walrus": "tsx scripts/probe-facts-walrus.ts",
    "diagnose": "tsx scripts/diagnose.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@mysten/sui": "^2.33.2",
    "@remora/chain": "workspace:*",
    "@remora/core": "workspace:*",
    "@remora/db": "workspace:*",
    "@remora/disc-sdk": "workspace:*",
    "@remora/memory": "workspace:*",
    "@remora/schema": "workspace:*",
    "@remora/signer": "workspace:*",
    "@slack/bolt": "^4.6.0",
    "ai": "^7.0.0",
    "discord.js": "^14.27.0",
    "grammy": "^1.46.0",
    "hono": "^4.13.13",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@remora/merchant": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
