{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build && mv dist/index.html dist/app.html && bun ../landing/build.ts --into dist",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-production-d2c7.up.railway.app/api/:path*"
    },
    {
      "source": "/badge/:path*",
      "destination": "https://api-production-d2c7.up.railway.app/badge/:path*"
    },
    {
      "source": "/about",
      "destination": "/landing.html"
    },
    {
      "source": "/",
      "missing": [{ "type": "cookie", "key": "remora_session" }],
      "destination": "/landing.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/connect/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/disconnect/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/me",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
